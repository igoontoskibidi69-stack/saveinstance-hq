module.Exit = function(self)
	local plot = plotHandler:GetPlot()
	if not enabled or not plot then
		return
	end

	-- Disable collisions for all pools
	for _, model in pairs(plot.House.Pools:GetChildren()) do
		if model:FindFirstChild("HitBox") then
			model.HitBox.CanCollide = false
		end
	end

	-- Notify the server that build mode is exited
	dataManager:FireServer({Type = "ExitBuild"})

	-- Ensure grid texture exists
	local gridTexture = gridPlane and gridPlane:FindFirstChild("Grid")
	if gridTexture then
		-- Animate grid texture transparency to 1 (fade out)
		interpolate(1, "Out", "Quad", function(t)
			gridTexture.Transparency = t
		end, true)
	end

	-- Disable build mode
	enabled = false
	buildModeChanged:Fire(false)

	-- Stop placing objects and update the list
	coroutine.wrap(module.StopPlacing)()
	coroutine.wrap(changeList, false)()

	-- Equip the tool and update UI state
	module:EquipTool()
	getHotbar():SetState(true)

	-- Create smooth tweens for UI elements to exit build mode
	local mainTween = TweenService:Create(main, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 1, -40)})
	local buildBarTween = TweenService:Create(buildBar, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(1, -buildBar.AbsoluteSize.X, 1, buildBar.AbsoluteSize.X + buildBar:WaitForChild("SettingsMenu").Position.Y.Offset)})
	local moodFrameTween = TweenService:Create(moodFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 1, -40)})

	-- Play the tweens
	mainTween:Play()
	buildBarTween:Play()
	moodFrameTween:Play()

	-- Stop build music in the background
	coroutine.wrap(function()
		soundHandler:Stop("BuildSong", 1)
	end)()

	-- Exit build mode from camera module
	cameraModule:ExitBuildMode()

	-- Hide the main UI element
	main.Visible = false


	local camera = workspace.CurrentCamera
