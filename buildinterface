				module:CreateList("Instruments", path)
			elseif info.Name == "Vehicles" then
				module:CreateList("Vehicles", path)
			end
		end)

		return btn
	end

	if path == "All" and categories[old] then
		local allItems = {}
		for _, cat in ipairs(categories[old]) do
			if cat ~= "All" then
				local catItems = items:GetItems(cat)
				if catItems then
					for itemName, itemData in pairs(catItems) do
						allItems[itemName] = itemData
					end
				end
			end
		end
		module.isType = allItems
	else
		-- If this is a leaf category (like "Beds"), get its items
		local itemData = items:GetItems(path)
		if itemData then
			module.isType = itemData
		else
			module.isCat = categories[path] -- still a subcategory? show category buttons
		end
	end

	if module.isType then
		local filtered = {}
		for _, data in pairs(module.isType) do
			table.insert(filtered, data)
		end
		module.isType = filtered
	end

	if not enabled then return end
	module:StopPlacing()

	if list.Visible or curPath == path then
		changeList(false)
	end

	if curPath ~= path and list.Position.Y.Offset >= 48 then
		list.BackgroundText.Text = ""
		list.Title.Text = categories[path] and "Categories" or path
		curPath = path
		changeList(true)
		scrollFrame.CanvasPosition = Vector2.new()

		clearScrollFrame()

		local xOffset, yOffset = 0, 0
		local buttonPadding = Vector2.new(2, 2)
		local frameMinSize = 414
		local money = clientStats:Get("Money")
		local blockbux = clientStats:Get("Blockbux")
		local maxX = math.max(5, math.floor(scrollFrame.AbsoluteSize.X / (buttonSize.X + buttonPadding.X)))
		btnCount = 0

		if path == "Build" or path == "Decorate" then
			for _, name in ipairs(categories[path] or {}) do
				if name ~= "All" then
					local info = catData[name] or { Name = name, Desc = "" }
					local btn = createCategoryButton(name, info)
					btnCount += 1

					xOffset = xOffset + buttonSize.X + buttonPadding.X
					if xOffset + buttonSize.X > scrollFrame.AbsoluteSize.X then
						xOffset = 0
						yOffset = yOffset + buttonSize.Y + buttonPadding.Y
					end
				end
			end
		elseif module.isType then
			for _, itemData in ipairs(module.isType) do
				local btn = createItemButton(itemData.Name, itemData)
				btnCount += 1

				xOffset = xOffset + buttonSize.X + buttonPadding.X
				if xOffset + buttonSize.X > scrollFrame.AbsoluteSize.X then
					xOffset = 0
					yOffset = yOffset + buttonSize.Y + buttonPadding.Y
				end
			end
		end

		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset + buttonSize.Y + buttonPadding.Y)
		list.Size = UDim2.new(0, math.max((buttonSize.X + buttonPadding.X) * maxX + 12 + scrollFrame.ScrollBarThickness, frameMinSize), list.Size.Y.Scale, list.Size.Y.Offset)
		list.BackgroundText.Text = btnCount > 0 and "" or "No items found."
		updateScrollBackgrounds()
		if path == "Build" or path == "Windows" or path == "Doors" then
			return
		end
	end

	list.Title.Back.Visible = old ~= nil
	list.Title.Sort.Visible = old ~= nil or path == "Inventory"
	list.Title.Sort.Position = UDim2.new(1, path == "Inventory" and -32 or -64, 0, 2)

	if old then
		table.insert(listEvents, list.Title.Back.MouseButton1Down:Connect(function()
			module:CreateList(old)
		end))
	end

	local function updateTable()
		if path ~= "Inventory" or not inventory:GetContent() then
			module.isCat = categories[path]

			if path == "All" and categories[old] then
				local allItems = {}
				for _, cat in ipairs(categories[old]) do
					if cat ~= "All" then
						local catItems = items:GetItems(cat)
						if catItems then
							for itemName, itemData in pairs(catItems) do
								allItems[itemName] = itemData
							end
						end
					end
				end
				module.isType = allItems
				module.isCat = nil
			end

			if module.isType then
				local newTable = {}
				for _, data in pairs(module.isType) do
					if (path ~= "Inventory" and not data.Hidden) or (path == "Inventory" and not inventory:IsStorage(data)) then
						if path == "Inventory" then
							local newData = items:GetItem(tostring(data))
							newData.InventoryValue = data
							data = newData
						end
						table.insert(newTable, data)
					end
				end

				local sortFunc = sortModes[curSort]

				local function safeSortFunc(a, b)
					local aName = a and a.Name or ""
					local bName = b and b.Name or ""
					return aName < bName
				end

				--table.sort(newTable, sortFunc or safeSortFunc)

				module.isType = newTable
			end
		end
	end

	if old or path == "Inventory" then
		table.insert(listEvents, list.Title.Sort.MouseButton1Down:Connect(function()
			wrapSortIndex()
			updateTable()
			list.BackgroundText.Text = btnCount > 0 and
				"This is your personal inventory.\nSpecial items that you've bought and collected are stored here."
				or "No items found! :("
		end))
	end

	updateTable()

	table.insert(listEvents, GUI.Changed:Connect(function() end)) -- Placeholder for any GUI updates

	if path == "Inventory" then
		table.insert(listEvents, inventory.Updated:Connect(function()
			updateTable()
		end))
	else
		table.insert(listEvents, clientStats.Updated:Connect(function(stat)
			if stat.Name == "Money" or stat.Name == "Blockbux" then
				print("stat is money or blockbux")
			end
		end))
	end
end



