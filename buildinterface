      if obj:IsA("SpecialMesh") then
        obj.VertexColor = Vector3.new(color.r, color.g, color.b)
      else
        if partData.Transparency then
          obj.Transparency = 0.5
        else
          obj.BrickColor = color
          if obj:IsA("UnionOperation") then
            obj.UsePartColor = true
          end
        end
      end
    end
    if obj:IsA("SpecialMesh") then
      obj.VertexColor = partData.Color
    else
      if partData.Transparency then
        obj.Transparency = partData.Transparency
      else
        obj.BrickColor = partData.Color
        if partData.MultiColor then
          obj.UsePartColor = false
        end
      end
    end
  end
end

