module.ConvertPos = function(self, pos, incSize, offset, fromBorder)
	local plot = plotHandler:GetPlot()
	if not plot or not plot:FindFirstChild("Ground") then
		warn("Plot or Ground missing!")
		return CFrame.new(pos) -- fallback
	end

	fromBorder = tonumber(fromBorder) or 0
	incSize = incSize or gridSize
	offset = offset or 0

	local center = plot.Ground.CFrame
	local gridPos = center:Inverse() * CFrame.new(pos)

	local x = gridPos.X
	local z = gridPos.Z

	local halfSize = 75
	local borderSize = fromBorder * gridSize
	local minBound = -halfSize + borderSize
	local maxBound = halfSize - borderSize

	local roundedX = offset + round((x - offset) / incSize) * incSize
	local clampedX = math.clamp(roundedX, minBound, maxBound)

	local roundedZ = offset + round((z - offset) / incSize) * incSize
	local clampedZ = math.clamp(roundedZ, minBound, maxBound)

	return center * CFrame.new(clampedX, gridPos.Y, clampedZ)
end


module.GetMousePos = function(self)
	local plot = plotHandler:GetPlot()
	if not plot or not plot:FindFirstChild("Ground") then
		warn("Plot or Ground not found")
		return CFrame.new()
	end

	if not mouse or not mouse.Hit then
		warn("Mouse or Mouse.Hit not available")
		return CFrame.new()
	end

	local center = plot.Ground.CFrame
	local gridPos = center:Inverse() * CFrame.new(mouse.Hit.Position)
	local rotation = gridPos - gridPos.Position

	local clampedX = math.clamp(gridPos.X, -75, 75)
	local clampedZ = math.clamp(gridPos.Z, -75, 75)
	local finalCFrame = CFrame.new(clampedX, gridPos.Y, clampedZ) * rotation

	return center * finalCFrame
end


