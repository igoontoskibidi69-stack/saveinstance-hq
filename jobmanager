module.GoToWork = function(self)
  
  local curJobModule = module:GetCurJobModule()
  if curJobModule then
    loadingHandler:ShowLoading()
    local root, torso = characterHandler:GetRoot(), characterHandler:GetObject("Torso")
    torso.Anchored = true
    local pos = curJobModule:GetModel():WaitForChild("WorkTeleport_" .. tostring(module:GetJob())).CFrame + Vector3.new(0, 5, 0)
