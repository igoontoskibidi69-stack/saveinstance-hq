local isChanging = false
module.ChangeJob = function(self, newJob)
	if isChanging then
		return
	end

	if newJob == "" then
		newJob = nil
	end

	if newJob == curJob then
		return
	end

	isChanging = true

	local promptText = ""
	local promptTitle = nil
	local input = nil

	if newJob then
		local curJobData = jobData:GetJob(newJob)
		assert(curJobData, "No JobData for " .. tostring(newJob))

		local jobTitle = tostring(curJobData.Title or "?")
		local jobLocation = tostring(curJobData.Location or "?")

		promptText = "Are you sure you want to start working as a " .. jobTitle .. " at " .. jobLocation .. "?\nEarned promotions will be lost!"
	else
		if curJob then
			promptText = "Are you sure you want to quit your job?\nEarned promotions will be lost!"
		else
			isChanging = false
			return false
		end
	end

	input = GUIHandler:ConfirmBox(promptText, promptTitle)

	local changed = false
	if input then
		changed = dataManager:InvokeServer({
			Type = "ChangeJob",
			Job = newJob,
			--StartShift = startShift
		})
	end

	isChanging = false
	return changed
end


