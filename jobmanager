module.CreateChatBubble = function(self, text, parent)
	local chatBubbleTemplate = assets:FindFirstChild("ChatBubble")
	if not chatBubbleTemplate then
		warn("ChatBubble template not found in assets.")
		return nil
	end

	local newBubble = chatBubbleTemplate:Clone()
	local body = newBubble:FindFirstChild("Body")
	local textLabel = body and body:FindFirstChild("TextLabel")

	if not textLabel then
		warn("ChatBubble missing Body or TextLabel.")
		return nil
	end

	textLabel.Text = text
	newBubble.Size = UDim2.new(0, 0, 0, 0)
	newBubble.StudsOffset = Vector3.new(0, 0, 0)
	newBubble.Enabled = false -- Prevent popping early during animation
	newBubble.Parent = parent

	interpolate(0.5, "Out", "Quad", function(t)
		newBubble.Size = UDim2.new(5 * t, 0, 2 * t, 0)
		newBubble.StudsOffset = Vector3.new(0, 2.5 * t, 0)
	end, true)

	newBubble.Enabled = true
	return newBubble
end


module.DestroyChatBubble = function(self, newBubble)
  
  spawn(function()
    
    interpolate(0.5, "In", "Quad", function(t)
      
      t = 1 - t
      newBubble.Size = UDim2.new(5 * (t), 0, 2 * (t), 0)
      newBubble.StudsOffset = Vector3.new(0, 2.5 * (t), 0)
    end
)
    newBubble:Destroy()
  end
)
end

