-- Loader

local function load(moduleInstance)

	local loaded

	task.spawn(function()

		task.wait(1)

		assert(loaded, "Unable to load " .. tostring(moduleInstance and moduleInstance:GetFullName() or moduleInstance))

	end)

	loaded = require(moduleInstance)

	return loaded

end

