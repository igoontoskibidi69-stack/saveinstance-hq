-- Handle daily rewards
local function handleDailyReward(player)
	local data = getPlayerData(player)

	-- Check if the player can claim the daily reward
	local currentTime = os.time()
	if currentTime - data.LastDailyClaim < 86400 then -- 86400 seconds = 1 day
		return false, "You can only claim your daily reward once every 24 hours!"
	end

	-- Reward the player with currency (you can modify this as needed)
	local dailyRewardAmount = 100
	data.Currency = data.Currency + dailyRewardAmount
	data.LastDailyClaim = currentTime
	savePlayerData(player, data)

	return true, "Daily reward claimed: " .. dailyRewardAmount .. " currency!"
end

-- Handle client-side plot selection and house creation requests
dataEvent.OnServerEvent:Connect(function(player, requestData)
	local type = requestData.Type

	if type == "SelectPlot" then
		local plotId = requestData.PlotId
		local success, message = handlePlotSelection(player, plotId)
		dataEvent:FireClient(player, "PlotSelectionResponse", success, message)

	elseif type == "LoadHouse" then
		loadPlayerHouses(player)
		dataEvent:FireClient(player, "HouseLoadComplete", "All houses loaded successfully!")

	elseif type == "ClaimDailyReward" then
		local success, message = handleDailyReward(player)
		dataEvent:FireClient(player, "DailyRewardResponse", success, message)
	elseif type == "" then

	end
end)

-- Handle player joining and leaving the game
game.Players.PlayerAdded:Connect(function(player)
	local data = getPlayerData(player)
	loadPlayerHouses(player)
	print(player.Name .. " has joined, data loaded.")
end)

game.Players.PlayerRemoving:Connect(function(player)
	-- You can save player data here if necessary (optional)
	local data = getPlayerData(player)
	savePlayerData(player, data)
	print(player.Name .. " has left, data saved.")
end)

-- Ensure player data is saved when they leave the game
game:BindToClose(function()
	for _, player in ipairs(game.Players:GetPlayers()) do
		local data = getPlayerData(player)
		savePlayerData(player, data)
	end
end)

