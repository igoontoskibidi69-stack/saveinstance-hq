local DataStoreService = game:GetService("DataStoreService")
local playerDataStore = DataStoreService:GetDataStore("PlayerDataStore")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local dataEvent = ReplicatedStorage:WaitForChild("DataEvent") 
local PlotManager = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("DataManager") 

-- Helper function to fetch player data or create default data
local function getPlayerData(player)
	local success, data = pcall(function()
		return playerDataStore:GetAsync(player.UserId)
	end)

	if success then
		return data or {Currency = 1000, Houses = {}, LastDailyClaim = 0}  -- Default data if none exists
	else
		warn("Failed to load data for player: " .. player.Name)

		-- Send failure event to client
		dataEvent:FireClient(player, {
			Type = "InitialLoadFailed",
			Message = "Unable to load your data from the server. Try another server."
		})

		return {Currency = 1000, Houses = {}, LastDailyClaim = 0}  -- Default fallback
	end
end


-- Save player data to the DataStore
local function savePlayerData(player, data)
	local success, errorMessage = pcall(function()
		playerDataStore:SetAsync(player.UserId, data)
	end)
	if not success then
		warn("Failed to save data for player " .. player.Name .. ": " .. errorMessage)
	end
end

-- Function to validate plot availability and house creation
local function handlePlotSelection(player, plotId)
	local data = getPlayerData(player)

	-- Check if plot is already owned
	if data.Houses[plotId] then
		return false, "You already own a house on this plot!"
	end

	local plot = PlotManager:FindFirstChild(plotId)
	if not plot then
		return false, "Invalid plot ID!"
	end

	-- Check if player has enough currency to buy the plot
	local plotCost = plot.Cost
	if data.Currency < plotCost then
		return false, "Insufficient funds to purchase this plot!"
	end

	-- Deduct the currency and update player data
	data.Currency = data.Currency - plotCost
	data.Houses[plotId] = {HouseID = plotId, CreatedAt = os.time()}
	savePlayerData(player, data)

	return true, "Plot purchased and house created!"
end

