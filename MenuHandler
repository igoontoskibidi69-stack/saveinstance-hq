dataManager:HookFunction("LoadingFailedPrompt", function(data)
	local objects = ""
	for type, amount in pairs(data.Data) do
		objects = objects .. tostring(type) .. ": " .. tostring(amount) .. "\n"
	end
	return GUIHandler:ConfirmBox("Unable to load " .. data.Objects .. " object" .. (data.Objects > 1 and "s" or "") .. "!\n\n" .. objects .. "\nDo you want to continue anyway? These objects will be permanently destroyed!", "Loading Failed")
end)

