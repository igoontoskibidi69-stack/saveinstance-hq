	end
end


showCreateHouse = function()
	characterFrame:SetState(false, true)
	createHouseFrame.Visible = true
	createHouseFrame.Position = UDim2.new(createHouseFrame.Position.X.Scale, 0, 1, 0)
	createHouseFrame:TweenPosition(UDim2.new(createHouseFrame.Position.X.Scale, 0, 0.4, 0), "Out", "Quad", 1, true)

	local ownedHouses = clientStats:GetStat("Houses"):GetChildren()
	selectedHouseTemplate = #ownedHouses < 1 and #houseTemplates - 2 or 1

	--inputManager:AddSelection("MainMenu_SelectNewHouse", {})
	inputManager:BindAction(
		"MainMenu_SelectNewHouse",
		function(actionName, inputState, inputObject)
			if inputState == Enum.UserInputState.Begin then
				local key = inputObject.KeyCode
				if key == Enum.KeyCode.DPadLeft or key == Enum.KeyCode.Left or key == Enum.KeyCode.ButtonL2 then
					updateCreateHouse(-1)
				elseif key == Enum.KeyCode.DPadRight or key == Enum.KeyCode.Right or key == Enum.KeyCode.ButtonR2 then
					updateCreateHouse(1)
				elseif key == Enum.KeyCode.Backspace or key == Enum.KeyCode.ButtonB then
					closeCreateHouse()
				elseif key == Enum.KeyCode.Return or key == Enum.KeyCode.ButtonA then
					createNewHouse:Fire()
				end
			end
		end,
		false,
		Enum.KeyCode.Return,
		Enum.KeyCode.ButtonA,
		Enum.KeyCode.Backspace,
		Enum.KeyCode.ButtonB,
		Enum.KeyCode.DPadLeft,
		Enum.KeyCode.Left,
		Enum.KeyCode.DPadRight,
		Enum.KeyCode.Right,
		Enum.KeyCode.ButtonL2,
		Enum.KeyCode.ButtonR2
	)

	updateCreateHouse()
end


local emptyPlots = {}
local selectedPlot = 1
local selectionBox = script:WaitForChild("SelectionBox")

changePlot = function(dif)

	selectedPlot = selectedPlot + dif
	if #emptyPlots < selectedPlot then
		selectedPlot = 1
	else
		if selectedPlot < 1 then
			selectedPlot = #emptyPlots
		end
	end
end

choosePlotCamera = function()
	local plot = emptyPlots[selectedPlot]

	if plot then
		local ground = plot:FindFirstChild("Ground") or plot:WaitForChild("Ground")
		local center = CFrame.new(ground.Position)

		camera.CFrame = center
			* CFrame.Angles(0, tick() * 0.2 % (math.pi * 2), 0)
			* CFrame.Angles(0.5, 0, 0)
			* CFrame.new(0, 0, -100)
			* CFrame.Angles(0, math.pi, 0)

		camera.Focus = center
		selectionBox.Adornee = ground
		selectionBox.Transparency = math.clamp(math.abs(math.sin(tick() * 3)), 0, 1)
	else
		selectionBox.Adornee = nil
	end
end


