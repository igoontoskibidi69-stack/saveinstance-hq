local houseTemplates = houseData:GetOrderedData()
local selectedHouseTemplate = 1
local createNewHouse = Instance.new("BindableEvent", script)
updateCreateHouse = function(change)

	local isFirst = #clientStats:GetStat("Houses"):GetChildren() < 1
	selectedHouseTemplate = selectedHouseTemplate + (change or 0)
	if selectedHouseTemplate <= 0 then
		selectedHouseTemplate = #houseTemplates
	elseif #houseTemplates < selectedHouseTemplate then
		selectedHouseTemplate = 1
	end
	local selectedTemplate = houseTemplates[selectedHouseTemplate]
	if isFirst and selectedTemplate.Name == "Empty Plot" then
		selectedHouseTemplate = 2
		selectedTemplate = houseTemplates[selectedHouseTemplate]
	end
	createHouseFrame:WaitForChild("HouseBox").Image = "rbxassetid://" .. selectedTemplate.Icon
	createHouseFrame.HouseBox:WaitForChild("TitleLabel").Text = selectedTemplate.Name
	local priceLabel = createHouseFrame.HouseBox:WaitForChild("PriceLabel"):WaitForChild("PriceLabel")
	priceLabel.Text = ((not isFirst or not selectedTemplate.IsStarter or not "Free!") and (not selectedTemplate.BSPrice or not textModule:SeparateNumber(selectedTemplate.BSPrice) .. " B$") and (selectedTemplate.Price > 0 and textModule:SeparateNumber(selectedTemplate.Price) .. " $")) or "Free!"
	do
		local showBack = true
		createHouseFrame:WaitForChild("Back").Visible = showBack
		createHouseFrame:WaitForChild("Select").Size = UDim2.new(0.65, -14, showBack and 0.078 or 0.166, 0)
	end
end

closeCreateHouse = function()
	createHouseFrame:TweenPosition(UDim2.new(createHouseFrame.Position.X.Scale, 0, 1, 0), "Out", "Quad", 1, true)

	if #clientStats:GetStat("Houses"):GetChildren() < 1 then
		showMain()
	else
