local updateHouseScroll = nil

showHouses = function()
	characterFrame:SetState(false, true)
	houseFrame.Visible = true
	houseFrame.Position = UDim2.new(houseFrame.Position.X.Scale, 0, 1, 0)
	houseFrame:TweenPosition(UDim2.new(houseFrame.Position.X.Scale, 0, 0.4, 0), "Out", "Quad", 1, true)
	local scrollFrame = houseFrame:WaitForChild("List"):WaitForChild("ScrollFrame")

	-- Hide or destroy existing buttons in the scroll frame
	for _, offset in pairs(scrollFrame:GetChildren()) do
		if offset.Name == "HouseButton" or offset.Name == "NewHouse" then
			offset.Visible = false
		elseif offset:IsA("GuiObject") then
			offset:Destroy()
		end
	end

	local createdButtons = {}
	local canClick = true

	-- Create buttons for each house
	for index, house in pairs(clientStats:GetStat("Houses"):GetChildren()) do
		local button = scrollFrame.HouseButton:clone()
		button.Visible = true
		button.Name = tostring(house) .. "_Button"
		button.Size = UDim2.new(1, 0, 0.16 * (#createdButtons + 1), 1)

		if tostring(house) ~= "" then
			button:WaitForChild("Button"):WaitForChild("NameLabel").Text = tostring(house)
			GUIHandler:RoundedButtonEffect(button:WaitForChild("Button"))

			button:WaitForChild("Button").MouseButton1Down:connect(function()
				if canClick then
					canClick = false
					housesBack()

					if tostring(house) == "" then
						showCreateHouse()
					else
						loadingHandler:ShowLoading()
						choosePlot()
						local worked = dataManager:InvokeServer({Type = "LoadHouse", House = house})
						if worked then
							module:HideMenu()
							loadingHandler:HideLoading()
						else
							loadingHandler:HideLoading()
							if not plotHandler:GetPlot() then
								GUIHandler:AlertBox("The server is currently full!\nJoin a different one or try again later...", "Full Server")
							else
								GUIHandler:AlertBox("Failed to load house!\nTry again later...", "Loading Failed")
							end
							showHouses()
						end
					end
				end
			end)

			button.Parent = scrollFrame
			table.insert(createdButtons, button.Button)
		end
	end

	-- Button to create a new house slot
	local button = scrollFrame.NewHouse:clone()
	button.Visible = true
	button.Name = button.Name .. "_Used"
	button.Size = UDim2.new(1, 0, 0.16 * (#createdButtons + 1), 1)
	GUIHandler:RoundedButtonEffect(button:WaitForChild("Button"))

	button:WaitForChild("Button").MouseButton1Down:connect(function()
		if canClick then
			if clientStats:Get("Blockbux") >= 300 then
				canClick = false
				housesBack()
				loadingHandler:ShowLoading()
				local worked = dataManager:InvokeServer({Type = "NewHouseSlot"})
				if worked then
					showCreateHouse()
				else
					loadingHandler:HideLoading()
					GUIHandler:AlertBox("Unable to create new house slot!\nTry again later...", "Creation Failed")
					showHouses()
				end
			else
				local frame = productPurchaser:ShowCurrencyFrame("Blockbux")
				frame:WaitForChild("NotEnoughLabel").Visible = true
			end
		end
	end)

	button.Parent = scrollFrame
	table.insert(createdButtons, button.Button)

	-- Adding input manager selection and binding action for Backspace or ButtonB
	--inputManager:AddSelection("MainMenu_Houses", createdButtons)
	inputManager:BindAction(
		"MainMenu_Houses",
		function(actionName, inputState, inputObject)
			if inputState == Enum.UserInputState.Begin then
				housesBack()
				showMain()
			end
		end,
		Enum.KeyCode.Backspace, Enum.KeyCode.ButtonB
	)

	-- Update house scroll size
	updateHouseScroll = function()
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, scrollFrame.AbsoluteSize.X * 0.16 * #createdButtons)
	end

	updateHouseScroll()
end

function module.AnimateCamera()
	if running then return end
	running = true

	task.spawn(function()
		local lastRandom = nil

		local function getValidRandom()
			local validSets = {}
			for _, camSet in ipairs(cameraPoints:GetChildren()) do
				if #camSet:GetChildren() >= 2 then
					table.insert(validSets, camSet)
				end
			end

			if #validSets == 0 then
				player:Kick("No valid camera sets.")
			end

			local newIndex
			repeat
				newIndex = math.random(#validSets)
			until newIndex ~= lastRandom

			lastRandom = newIndex
			return validSets[newIndex]
		end

		camera.CameraType = Enum.CameraType.Scriptable
		camera.CameraSubject = nil

		while menu and menu.Visible and running do
			task.wait()

			local set = getValidRandom()
			if not set then break end

			local points = set:GetChildren()
			local pointA = points[1]
			local pointB = points[2]

			local distance = (pointA.Position - pointB.Position).Magnitude
			local waitTime = distance / 10

			camera.CFrame = pointA.CFrame
			camera.Focus = pointA.CFrame * CFrame.new(0, 0, -10)

			local success, err = pcall(function()
				camera:Interpolate(pointB.CFrame, pointB.CFrame * CFrame.new(0, 0, -10), waitTime)
				task.wait(waitTime + 0.1)
			end)

			if not success then
				warn("[MenuCamera] Interpolation error:", err)
				task.wait(1)
			end
		end

		module.ResetCamera()
	end)
end

function module.Stop()
	running = false
end

function module.ResetCamera()
	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = player.Character and player.Character:FindFirstChildWhichIsA("Humanoid")
end

module.ShowMenu = function(self, ignoreSound)
	menu.BackgroundTransparency = 0
	
	logo.Position = UDim2.new(-0.125, 0, 0.2, 0)
	logo.Size = UDim2.new(1.25, 0, 0.5, 0)
	
	module:SetAllState(false)
	
	for _,frame in pairs(menuframe:GetChildren()) do
		if frame:IsA("GuiObject") and frame.Name ~= "LoadingLabel" then
			frame.Visible = false
		end
	end
	
	--showMain()
	if not ignoreSound then
		game.StarterGui.Modules.SoundHandler:WaitForChild("Local").MenuSong:Play()
	end
	
	menu.Visible = true
	
	interpolate(1, "Out", "Quad", function(t)
		menu.BackgroundTransparency = t
	end, true)
	
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CameraSubject = nil
	
	camera.CFrame = game.Workspace.MenuFirst.CFrame
	
	loadingLabel.Visible = true

	local start = tick()
	repeat
		local delta = tick() - start
		loadingLabel.Text = "Waiting for data to load" .. string.rep(".", math.floor(delta * 2) % 3 + 1)
		renderStepped:Wait()
	until (delta >= 2)

	if initLoadFailed then
		loadingLabel.Text = "Loading failed!"
		return false
	else
		loadingLabel.Text = "Data loaded!"
	end

	logo.Visible = true

	-- Collect and send house data
	local houseData = {}

	for _, house in ipairs(clientStats:GetStat("Houses"):GetChildren()) do
		local positionVector = Vector3.new(0, 0, 0)

		-- Try getting a Position Vector3Value first
		local positionValue = house:FindFirstChild("Position")
		if positionValue and positionValue:IsA("Vector3Value") then
			positionVector = positionValue.Value
		elseif house:IsA("Model") and house.PrimaryPart then
			-- If the house is a model with PrimaryPart, use its position
			positionVector = house.PrimaryPart.Position
		end

		-- Insert serialized position (as a table of X, Y, Z numbers)
		table.insert(houseData, {
			Name = house.Name,
			Template = house:FindFirstChild("Template") and house.Template.Value or "",
			Position = {X = positionVector.X, Y = positionVector.Y, Z = positionVector.Z}
		})
	end



	if #houseData > 0 then -- Only send if there is data
		local success, err = pcall(function()
			dataManager:FireServer({
				Type = "SaveHouseData",
				Data = houseData
			})
		end)

		if not success then
			warn("[ShowMenu] Failed to send house data for saving! Error:", err)
		end
	else
		warn("[ShowMenu] No house data found to send.")
	end

	logo:TweenSizeAndPosition(UDim2.new(0.8, 0, 0.32, 0), UDim2.new(0.1, 0, 0.05, 0), "Out", "Quad", 1, true)
	loadingLabel:TweenPosition(UDim2.new(loadingLabel.Position.X.Scale, 0, 1, 0), "Out", "Quad", 1, true)

	local workinprogressmessage = GUIHandler.createMessageBox("'Welcome to Bloxburg' is in an early stage of development and is actively being worked on.\n\nGameplay is not final and bugs may occur.\n\nPlease send suggestions and bug reports to Coeptus.", "Work in progress!", Color3.fromRGB(0, 170, 255))
	showMain()
	
	for _, button in pairs(mainFrame:GetChildren()) do
		if button:FindFirstChild("TextLabel") and button.TextLabel.TextTransparency == 0 then
			GUIHandler:RoundedButtonEffect(button)
			table.insert(mainButtons, button)

			button.MouseButton1Down:Connect(function()
				if button.Name == "Play" then
					if #clientStats:GetStat("Houses"):GetChildren() < 1 then
						showCreateHouse()
					else
						showHouses()
					end
				elseif button.Name == "Store" then
					inputManager:RemoveSelection("MainMenu_Main")
					mainFrame:TweenPosition(UDim2.new(mainFrame.Position.X.Scale, 0, 1, 0), "Out", "Quad", 1, true)
					GUIHandler.createMessageBox("All gamepasses go to the main game. Purchased a gamepass there, syncs here", "Notice", Color3.fromRGB(0, 170, 255))
					productPurchaser:ShowStore()
					showMain()
					return
				elseif button.Name == "Options" then
					inputManager:RemoveSelection("MainMenu_Main")
					mainFrame:TweenPosition(UDim2.new(mainFrame.Position.X.Scale, 0, 1, 0), "Out", "Quad", 1, true)
					optionsHandler:ShowOptions()
					showMain()
					return
				end
				inputManager:RemoveSelection("MainMenu_Main")
				mainFrame:TweenPosition(UDim2.new(mainFrame.Position.X.Scale, 0, 1, 0), "Out", "Quad", 1, true)
			end)
			
			local housesBackButton = houseFrame:WaitForChild("Back")
			GUIHandler:RoundedButtonEffect(housesBackButton)
			housesBackButton.MouseButton1Down:Connect(function()
				housesBack()
				showMain()
			end)

			for _, obj in pairs(createHouseFrame:GetChildren()) do
				if obj:IsA("ImageButton") then
					GUIHandler:RoundedButtonEffect(obj)
					obj.MouseButton1Down:Connect(function()
						if obj.Name == "Back" then
							closeCreateHouse()
						elseif obj.Name == "Next" then
							updateCreateHouse(1)
						elseif obj.Name == "Previous" then
							updateCreateHouse(-1)
						elseif obj.Name == "Select" then
							createNewHouse:Fire()
						end
					end)
				end
			end
			
			createNewHouse.Event:Connect(function()
				local selectedTemplate = houseTemplates[selectedHouseTemplate]
				local price = selectedTemplate.Price
				local houseCount = #clientStats:GetStat("Houses"):GetChildren()
				local isStarter = selectedTemplate.IsStarter
				local priceType

				if houseCount < 1 and isStarter then
					price = 0
					priceType = "Money"
				elseif selectedTemplate.BSPrice then
					price = selectedTemplate.BSPrice
					priceType = "Blockbux"
				else
					price = selectedTemplate.Price
					priceType = "Money"
				end


				if price <= clientStats:Get(priceType) then
					createHouseFrame:TweenPosition(UDim2.new(createHouseFrame.Position.X.Scale, 0, 1, 0), "Out", "Quad", 1, true)
					inputManager:UnbindAction("MainMenu_SelectNewHouse")
					inputManager:RemoveSelection("MainMenu_SelectNewHouse")

					local function promptName(name)
						if not name then
							local houseName = GUIHandler.CreateInputBox("Name your house", selectedTemplate.Name, game.Players.LocalPlayer.PlayerGui.MainGUI, 0.5, inputManager)
							if not plotHandler:CheckPlotName(houseName, player) then
								GUIHandler:AlertBox("The name you entered was invalid!\nPlease choose a different one...", "Invalid Name")
								return promptName(houseName)
							end
							return houseName
						end
					end

					local houseName = promptName()
					choosePlot()
					loadingHandler:ShowLoading()

					local success, worked = pcall(function()
						return dataManager:InvokeServer({Type = "NewHouse", Index = selectedHouseTemplate, Name = houseName})
					end)
					
					if success and worked then
						module:HideMenu()
						menu.Visible = false
						camera.CameraType = "Custom"
						soundHandler:Stop("MenuSong", 1)
						loadingHandler:HideLoading()
						local loadingFrame = player.PlayerGui.MainGUI:FindFirstChild("LoadingFrame")
						if loadingFrame and loadingFrame.Visible == true then
							loadingFrame.Visible = false
						end
						
						local position = game.Workspace.Plots:WaitForChild("Plot_" .. player.Name):WaitForChild("Spawn").Position
						
						if character and character.PrimaryPart then
							character:PivotTo(CFrame.new(position + Vector3.new(0, 5, 0)))
						end
							
						if game.StarterGui.Modules.SoundHandler:WaitForChild("Local").MenuSong.IsPlaying then
							game.StarterGui.Modules.SoundHandler:WaitForChild("Local").MenuSong:Stop()
						end
					else
						loadingHandler:HideLoading()
						if not plotHandler:GetPlot() then
							GUIHandler:AlertBox("The server is currently full!\nJoin a different one or try again later...", "Full Server")
						else
							GUIHandler:AlertBox("Failed to create new house!\nTry again later...", "Creation Failed")
						end
						showCreateHouse()
					end
					--loadingHandler:HideLoading()
				else
					GUIHandler:AlertBox("Not enough currency! Please try again later..", "Currency Failure")
					local frame = productPurchaser:ShowCurrencyFrame(priceType)
					frame:WaitForChild("NotEnoughLabel").Visible = true
				end
			end)
		end
	end
end

module.HideMenu = function(self, ignoreSound)

	module:SetAllState(true)
	menu.Visible = false
	camera.CameraType = "Custom"
	if not ignoreSound then
		spawn(function()
			soundHandler:Stop("MenuSong", 1)
		end
		)
	end
end

