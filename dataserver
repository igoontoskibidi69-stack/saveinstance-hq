	ShowParty.Name = "ShowParty"
	ShowParty.Value = true
	ShowParty.Parent = options

	createIntValue(options, "GlobalVolume")
	createIntValue(options, "LocalVolume")

	local skillData = Instance.new("Folder")
	skillData.Name = "SkillData"
	skillData.Parent = playerStats

	local skillNames = {
		"Athletic",
		"Cooking",
		"Crafting",
		"Gaming",
		"Gardening",
		"Intelligence",
		"Music",
		"Painting",
		"Programming",
		"Writing"
	}

	for _, skill in ipairs(skillNames) do
		local skillValue = Instance.new("IntValue")
		skillValue.Name = skill
		skillValue.Value = 0
		skillValue.Parent = skillData

		local progress = Instance.new("IntValue")
		progress.Name = "Progress"
		progress.Value = 0
		progress.Parent = skillValue

		local progressIncrease = Instance.new("IntValue")
		progressIncrease.Name = "ProgressIncrease"
		progressIncrease.Value = 0
		progressIncrease.Parent = skillValue
	end

