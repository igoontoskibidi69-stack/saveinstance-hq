		warn("Invalid player passed to SetPermission")
		return
	end

	targetPlayer:SetAttribute(plr.UserId .. "_Permission", index)

	DataManager:FireClient(targetPlayer, {
		Type = "PermissionChanged",
		Owner = plr,
		Index = index
	})
